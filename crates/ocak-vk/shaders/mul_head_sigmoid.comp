#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer G { float g[]; };
layout(push_constant) uniform PC { uint n_heads; uint head_dim; } pc;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.n_heads * pc.head_dim;
    if (idx >= total) return;
    uint h = idx / pc.head_dim;
    x[idx] *= 1.0 / (1.0 + exp(-g[h]));
}
