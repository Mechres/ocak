#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_GOOGLE_include_directive : require
// Integer-dot tiled matmul for prefill: Y[batch, m] = X[batch, k] * W[m, k]^T with X
// pre-quantized by quant_q8.comp (int8 blocks of 32 + per-16 sums). Same tile shape as
// qmm_tiled.comp (64 rows x 128 tokens, BK = 32), but the weight tile stays int8 and the inner
// product is dotPacked4x8EXT (4 MACs per instruction) with one float scale fix-up per
// 16-column group:  sum_i (d q_i - m) * dx qx_i = d dx (q . qx) - m (dx sum qx).
// Compiled once per weight format with -D<TYPE> (see build.rs).
#if defined(Q6_K) || defined(Q3_K) || defined(IQ2_XS) || defined(IQ2_S) || defined(IQ1_M) || defined(NVFP4)
#define SCALE16
#endif
// Formats with a per-block min (weights d * q - m); the others skip the min fix-up.
#if defined(Q4_K) || defined(Q5_K) || defined(Q2_K)
#define HAS_MIN
#endif
// Q2_K: one weight scale per 32 (sub-scales folded into the integers) but a min per 16.
#if defined(Q2_K)
#define MIN16
#endif
#define TM 4u
#define BM 64u
#ifdef GROUPED
#define TN 4u
#else
#define TN 8u
#endif
#define BN (16u * TN)
#define WPT (BN / 32u)          // activation words loaded per thread per K block
#define TPC (8u / WPT)          // loader threads per activation column
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 0) readonly buffer W32 { uint w32[]; };
layout(set = 0, binding = 1) readonly buffer XQ { uint xq[]; };
layout(set = 0, binding = 2) readonly buffer XS { vec4 xsc[]; };
layout(set = 0, binding = 3) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 4) readonly buffer T { uint tbl[]; };
// q_off4 / s_off: uvec4 / vec4 offsets of the quantized activations and their scales.
#ifdef GROUPED
// Grouped ("mul_mat_id") variant, as in qmm_tiled.comp: workgroup y = group (expert), z =
// column tile; group g uses weight slice w_off + g * slice_bytes; its columns are entries from
// the moe_group.comp list (use_list != 0) or entry = j * n_groups + g. Entry e reads quantized
// activation row e / x_div and writes Y row e * m.
layout(set = 0, binding = 5) readonly buffer L { uint glist[]; };
layout(push_constant) uniform PC {
    uint w_off; uint q_off4; uint s_off; uint y_off; uint k; uint m; uint row_bytes;
    uint x_div; uint slice_bytes; uint n_groups; uint count; uint use_list; uint cap;
} pc;
#else
// Split-K (small m, large k): workgroup z covers K blocks [z * kbchunk, (z + 1) * kbchunk) and
// writes its partial result at y_off + z * split_stride (summed by sum_splits.comp).
layout(push_constant) uniform PC { uint w_off; uint q_off4; uint s_off; uint y_off; uint k; uint m; uint row_bytes; uint batch; uint kbchunk; uint split_stride; } pc;
#endif

shared uvec4 ws[8u * (BM / 4u)];   // [k word][row / 4] (4 consecutive rows per uvec4)
shared uvec4 xs[8u * (BN / 4u)];   // [k word][col / 4]
shared float wsd[2u * BM];         // weight scale d per row, for the two 16-col halves
shared float xsd[BN];              // activation scale dx per column
#ifdef HAS_MIN
shared float wsm[2u * BM];         // weight min m per row and half
shared float xsm[2u * BN];         // dx * sum(qx) per column and half
#endif

#include "dequant_i8.glsl"


void main() {
    uint lid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
#ifdef GROUPED
    uint grp = gl_WorkGroupID.y;
    uint tok0 = gl_WorkGroupID.z * BN;
    uint ncols = (pc.use_list != 0u) ? glist[grp] : pc.count;
    if (tok0 >= ncols) return;
    uint wbase = pc.w_off + grp * pc.slice_bytes;
#else
    uint tok0 = gl_WorkGroupID.y * BN;
    uint ncols = pc.batch;
    uint wbase = pc.w_off;
#endif

    // Weight loader: row lid/4, 8 columns (2 words) per thread.
    uint ld_row = lid >> 2;
    uint ld_part = lid & 3u;
    uint rb = wbase + min(row0 + ld_row, pc.m - 1u) * pc.row_bytes;
    // Activation loader: column lid / TPC, WPT words per thread.
    uint x_col = lid / TPC;
    uint x_part = lid % TPC;
    uint col = min(tok0 + x_col, ncols - 1u);
    uint kblocks = pc.k >> 5;
#ifdef GROUPED
    uint xentry = (pc.use_list != 0u) ? glist[pc.n_groups + grp * pc.cap + col] : col * pc.n_groups + grp;
    uint xblk0 = (xentry / pc.x_div) * kblocks;
#else
    uint xblk0 = col * kblocks;
#endif
#ifdef GROUPED
    uint kb_beg = 0u, kb_end = kblocks, ybase = pc.y_off;
#else
    uint kb_beg = gl_WorkGroupID.z * pc.kbchunk;
    uint kb_end = min(kblocks, kb_beg + pc.kbchunk);
    uint ybase = pc.y_off + gl_WorkGroupID.z * pc.split_stride;
#endif

    uint tx = lid & 15u;   // rows tx*4 .. +3
    uint ty = lid >> 4;    // cols ty*TN .. +TN-1
    float acc[TN][TM];
    for (uint j = 0u; j < TN; j++)
        for (uint i = 0u; i < TM; i++) acc[j][i] = 0.0;

    // Register prefetch: the next K block's weights / activations are loaded from global memory
    // while the current one is computed from shared memory.
    uint pq0, pq1;
    float pd, pm;
    uint pxv[WPT];
    vec4 pxs;
    dqi8(rb, (kb_beg << 5) + ld_part * 8u, pq0, pq1, pd, pm);
    for (uint c = 0u; c < WPT; c++) pxv[c] = xq[pc.q_off4 * 4u + (xblk0 + kb_beg) * 8u + x_part * WPT + c];
    pxs = xsc[pc.s_off + xblk0 + kb_beg];

    for (uint kb = kb_beg; kb < kb_end; kb++) {
        {
            uint kw = ld_part * 2u;
            ws[kw * (BM / 4u) + (ld_row >> 2)][ld_row & 3u] = pq0;
            ws[(kw + 1u) * (BM / 4u) + (ld_row >> 2)][ld_row & 3u] = pq1;
            if ((ld_part & 1u) == 0u) {
                wsd[(ld_part >> 1) * BM + ld_row] = pd;
#ifdef HAS_MIN
                wsm[(ld_part >> 1) * BM + ld_row] = pm;
#endif
            }
            for (uint c = 0u; c < WPT; c++)
                xs[(x_part * WPT + c) * (BN / 4u) + (x_col >> 2)][x_col & 3u] = pxv[c];
            if (x_part == 0u) {
                xsd[x_col] = pxs.x;
#ifdef HAS_MIN
                xsm[x_col] = pxs.y;
                xsm[BN + x_col] = pxs.z;
#endif
            }
        }
        barrier();
        if (kb + 1u < kb_end) {
            dqi8(rb, ((kb + 1u) << 5) + ld_part * 8u, pq0, pq1, pd, pm);
            for (uint c = 0u; c < WPT; c++) pxv[c] = xq[pc.q_off4 * 4u + (xblk0 + kb + 1u) * 8u + x_part * WPT + c];
            pxs = xsc[pc.s_off + xblk0 + kb + 1u];
        }
#ifdef SCALE16
        // d (and m) change every 16 columns: one fix-up per half.
        for (uint h = 0u; h < 2u; h++) {
            int ia[TN][TM];
            for (uint j = 0u; j < TN; j++)
                for (uint i = 0u; i < TM; i++) ia[j][i] = 0;
            for (uint c = 0u; c < 4u; c++) {
                uint kw = h * 4u + c;
                uvec4 wv = ws[kw * (BM / 4u) + tx];
#ifdef GROUPED
                uvec4 xr = xs[kw * (BN / 4u) + ty];
                for (uint i = 0u; i < TM; i++)
                    for (uint j = 0u; j < TN; j++)
                        ia[j][i] += dotPacked4x8EXT(int(wv[i]), int(xr[j]));
#else
                uvec4 xa = xs[kw * (BN / 4u) + ty * 2u];
                uvec4 xb = xs[kw * (BN / 4u) + ty * 2u + 1u];
                for (uint i = 0u; i < TM; i++) {
                    for (uint j = 0u; j < 4u; j++) {
                        ia[j][i] += dotPacked4x8EXT(int(wv[i]), int(xa[j]));
                        ia[j + 4u][i] += dotPacked4x8EXT(int(wv[i]), int(xb[j]));
                    }
                }
#endif
            }
            float wd[TM];
            for (uint i = 0u; i < TM; i++) wd[i] = wsd[h * BM + tx * TM + i];
#ifdef HAS_MIN
            float wm[TM];
            for (uint i = 0u; i < TM; i++) wm[i] = wsm[h * BM + tx * TM + i];
#endif
            for (uint j = 0u; j < TN; j++) {
                float xd = xsd[ty * TN + j];
#ifdef HAS_MIN
                float xm = xsm[h * BN + ty * TN + j];
#endif
                for (uint i = 0u; i < TM; i++)
#ifdef HAS_MIN
                    acc[j][i] += float(ia[j][i]) * (wd[i] * xd) - wm[i] * xm;
#else
                    acc[j][i] += float(ia[j][i]) * (wd[i] * xd);
#endif
            }
        }
#else
        // d and m are constant over the 32-column block: one fix-up per block.
        {
            int ia[TN][TM];
            for (uint j = 0u; j < TN; j++)
                for (uint i = 0u; i < TM; i++) ia[j][i] = 0;
            for (uint kw = 0u; kw < 8u; kw++) {
                uvec4 wv = ws[kw * (BM / 4u) + tx];
#ifdef GROUPED
                uvec4 xr = xs[kw * (BN / 4u) + ty];
                for (uint i = 0u; i < TM; i++)
                    for (uint j = 0u; j < TN; j++)
                        ia[j][i] += dotPacked4x8EXT(int(wv[i]), int(xr[j]));
#else
                uvec4 xa = xs[kw * (BN / 4u) + ty * 2u];
                uvec4 xb = xs[kw * (BN / 4u) + ty * 2u + 1u];
                for (uint i = 0u; i < TM; i++) {
                    for (uint j = 0u; j < 4u; j++) {
                        ia[j][i] += dotPacked4x8EXT(int(wv[i]), int(xa[j]));
                        ia[j + 4u][i] += dotPacked4x8EXT(int(wv[i]), int(xb[j]));
                    }
                }
#endif
            }
            float wd[TM];
            for (uint i = 0u; i < TM; i++) wd[i] = wsd[tx * TM + i];
#ifdef HAS_MIN
            float wm[TM];
            for (uint i = 0u; i < TM; i++) wm[i] = wsm[tx * TM + i];
#endif
#ifdef MIN16
            float wm1[TM];
            for (uint i = 0u; i < TM; i++) wm1[i] = wsm[BM + tx * TM + i];
#endif
            for (uint j = 0u; j < TN; j++) {
                float xd = xsd[ty * TN + j];
#ifdef HAS_MIN
#ifdef MIN16
                float xm0 = xsm[ty * TN + j];
                float xm1 = xsm[BN + ty * TN + j];
#else
                float xm = xsm[ty * TN + j] + xsm[BN + ty * TN + j];
#endif
#endif
                for (uint i = 0u; i < TM; i++)
#ifdef MIN16
                    acc[j][i] += float(ia[j][i]) * (wd[i] * xd) - (wm[i] * xm0 + wm1[i] * xm1);
#elif defined(HAS_MIN)
                    acc[j][i] += float(ia[j][i]) * (wd[i] * xd) - wm[i] * xm;
#else
                    acc[j][i] += float(ia[j][i]) * (wd[i] * xd);
#endif
            }
        }
#endif
        barrier();
    }

    for (uint j = 0u; j < TN; j++) {
        uint c = tok0 + ty * TN + j;
        if (c >= ncols) break;
#ifdef GROUPED
        uint yentry = (pc.use_list != 0u) ? glist[pc.n_groups + grp * pc.cap + c] : c * pc.n_groups + grp;
#else
        uint yentry = c;
#endif
        for (uint i = 0u; i < TM; i++) {
            uint row = row0 + tx * TM + i;
            if (row < pc.m) y[ybase + yentry * pc.m + row] = acc[j][i];
        }
    }
}
