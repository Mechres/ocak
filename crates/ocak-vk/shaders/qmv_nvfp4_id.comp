#version 460
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 32, local_size_y = 4) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 3) readonly buffer Ids { uint ids[]; };
layout(push_constant) uniform PC { uint slot; uint x_off; uint y_off; uint k; uint m; uint row_bytes; uint slice_bytes; uint x_stride; } pc;
const float KFP4[16] = float[16](0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0, 0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0);
float ue4m3(uint v) {
    if (v == 0u || v == 0x7Fu) return 0.0;
    uint e = (v >> 3) & 0xFu;
    uint m = v & 7u;
    return (e == 0u) ? (float(m) * (1.0 / 1024.0)) : uintBitsToFloat(((e + 119u) << 23) | (m << 20));
}
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.x * 4u + ly;
    uint s_idx = gl_WorkGroupID.y;
    float acc = 0.0;
    if (row < pc.m) {
        uint exp_id = ids[pc.slot + s_idx];
        uint rbase = exp_id * pc.slice_bytes + row * pc.row_bytes;
        uint xbase = pc.x_off + s_idx * pc.x_stride;
        uint nsub = pc.k / 16u;
        for (uint sb = tid; sb < nsub; sb += 32u) {
            uint blk = sb >> 2;
            uint s = sb & 3u;
            uint b = rbase + blk * 36u;
            float d = ue4m3(uint(w[b + s]));
            uint xo = xbase + sb * 16u;
            uint qo = b + 4u + s * 8u;
            float sum = 0.0;
            for (uint j = 0u; j < 8u; j += 2u) {
                uint q0 = uint(w[qo + j]);
                uint q1 = uint(w[qo + j + 1u]);
                sum += KFP4[q0 & 0xFu] * x[xo + j] + KFP4[q0 >> 4] * x[xo + 8u + j]
                     + KFP4[q1 & 0xFu] * x[xo + j + 1u] + KFP4[q1 >> 4] * x[xo + 9u + j];
            }
            acc += d * sum;
        }
    }
    float s_out = subgroupClusteredAdd(acc, 32u);
    if (tid == 0u && row < pc.m) y[pc.y_off + s_idx * pc.m + row] = s_out;
}
