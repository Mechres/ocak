#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) readonly buffer W { float w[]; };
layout(set = 0, binding = 3) readonly buffer Ids { uint ids[]; };
layout(set = 0, binding = 4) readonly buffer DnScales { float dn_sc[]; };
layout(push_constant) uniform PC { uint n; uint slot; uint count; uint overwrite; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float acc = (pc.overwrite != 0u) ? 0.0 : a[i];
    for (uint k = 0u; k < pc.count; k++) {
        uint s = pc.slot + k;
        acc += w[s] * dn_sc[ids[s]] * b[k * pc.n + i];
    }
    a[i] = acc;
}
