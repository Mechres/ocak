#version 460
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer KCur { float kc[]; };
layout(set = 0, binding = 2) readonly buffer VCur { float vc[]; };
layout(set = 0, binding = 3) readonly buffer R { float r[]; };
layout(set = 0, binding = 4) readonly buffer Sinks { float sinks[]; };
layout(set = 0, binding = 5) readonly buffer Gate { float gate[]; };
layout(set = 0, binding = 6) readonly buffer QClip { float qclip[]; };
layout(set = 0, binding = 7) readonly buffer RClip { float rclip[]; };
layout(set = 0, binding = 8) readonly buffer RelBias { float rbias[]; };
layout(set = 0, binding = 9) buffer KCache { uint kcache[]; };
layout(set = 0, binding = 10) buffer VCache { uint vcache[]; };
layout(set = 0, binding = 11) writeonly buffer Out { float o[]; };
layout(push_constant) uniform PC {
    uint q_off;
    uint r_off;
    uint s_off;
    uint g_off;
    uint n_head;
    uint n_head_kv;
    uint hd;
    uint n_rel;
    uint n_extent;
    uint n_swa;
    uint is_swa;
    uint cap;
    uint pos;
    uint kv_slot_off;
    float qk_clip;
    float rel_clip;
    float tau;
    float eps;
} pc;
shared float sq[128];
shared float sr[32];
shared float sk_cur[128];
shared float sk_tmp[128];
shared float smax[128];
shared float ssum[128];
shared float tile_p[128];   // softmax numerators for the current 128-token tile
void main() {
    uint h = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint gqa = pc.n_head / pc.n_head_kv;
    uint kvh = h / gqa;
    uint half_hd = pc.hd >> 1;
    uint half_kv_dim = pc.n_head_kv * half_hd;
    uint slot_pos = (pc.is_swa != 0u) ? (pc.pos % pc.cap) : pc.pos;

    // 1. Compute clipped K and RMSNormed V for current pos; first head in GQA group stores packed FP16 to cache
    float k_cur_val;
    float v_cur_val;
    {
        float kv = kc[kvh * pc.hd + tid];
        sk_tmp[tid] = kv * kv;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) sk_tmp[tid] += sk_tmp[tid + s]; barrier(); }
        float knorm = sqrt(sk_tmp[0]);
        barrier();
        k_cur_val = kv * ((knorm > pc.qk_clip) ? (pc.qk_clip / knorm) : 1.0);
        sk_cur[tid] = k_cur_val;

        float vv = vc[kvh * pc.hd + tid];
        sk_tmp[tid] = vv * vv;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) sk_tmp[tid] += sk_tmp[tid + s]; barrier(); }
        float v_ss = sk_tmp[0];
        barrier();
        v_cur_val = vv * inversesqrt(v_ss / float(pc.hd) + pc.eps);
        sk_tmp[tid] = v_cur_val;
        barrier();
        if (h % gqa == 0u && tid < half_hd) {
            uint dst = pc.kv_slot_off + slot_pos * half_kv_dim + kvh * half_hd + tid;
            kcache[dst] = packHalf2x16(vec2(sk_cur[2u * tid], sk_cur[2u * tid + 1u]));
            vcache[dst] = packHalf2x16(vec2(sk_tmp[2u * tid], sk_tmp[2u * tid + 1u]));
        }
        barrier();
    }

    // 2. Clip Q (with qclip) and R (with rclip)
    float qv = q[pc.q_off + h * pc.hd + tid] * qclip[h * pc.hd + tid];
    sq[tid] = qv * qv;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) sq[tid] += sq[tid + s]; barrier(); }
    float qnorm = sqrt(sq[0]);
    barrier();
    float qf = ((qnorm > pc.qk_clip) ? (pc.qk_clip / qnorm) : 1.0) * ((pc.is_swa == 0u) ? pc.tau : 1.0);
    sq[tid] = qv * qf;

    if (tid < pc.n_rel) {
        float rv = r[pc.r_off + h * pc.n_rel + tid] * rclip[h * pc.n_rel + tid];
        sr[tid] = rv;
        sk_tmp[tid] = rv * rv;
    } else {
        sk_tmp[tid] = 0.0;
    }
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) sk_tmp[tid] += sk_tmp[tid + s]; barrier(); }
    float rnorm = sqrt(sk_tmp[0]);
    barrier();
    float rf = ((rnorm > pc.rel_clip) ? (pc.rel_clip / rnorm) : 1.0) * ((pc.is_swa == 0u) ? pc.tau : 1.0);
    if (tid < pc.n_rel) sr[tid] *= rf;
    barrier();

    // 3. Attention scores over t_start..=pos + zero sink
    uint t_start = (pc.is_swa != 0u && pc.pos + 1u > pc.n_swa) ? (pc.pos + 1u - pc.n_swa) : 0u;
    uint t_len = pc.pos - t_start + 1u;
    float scale = inversesqrt(float(pc.hd));
    float sink_t = sinks[pc.s_off + h];

    // Online softmax over 128-token tiles (no context-length cap). The zero-logit sink is the
    // initial state: m = 0, l = exp(0 - 0) = 1, contributing to the normalizer but not to V.
    uint d2 = tid >> 1;
    uint lane = tid & 1u;
    float m_run = 0.0;
    float l_run = 1.0;
    float acc = 0.0;
    for (uint base = 0u; base < t_len; base += 128u) {
        uint tile_len = min(128u, t_len - base);
        uint idx = base + tid;
        float sc = -3.402823466e38;
        if (tid < tile_len) {
            uint t = t_start + idx;
            uint sp = (pc.is_swa != 0u) ? (t % pc.cap) : t;
            float dot = 0.0;
            if (t == pc.pos) {
                for (uint d = 0u; d < pc.hd; d++) dot += sq[d] * sk_cur[d];
            } else {
                uint kb = pc.kv_slot_off + sp * half_kv_dim + kvh * half_hd;
                for (uint e2 = 0u; e2 < half_hd; e2++) {
                    vec2 kv = unpackHalf2x16(kcache[kb + e2]);
                    dot += sq[2u * e2] * kv.x + sq[2u * e2 + 1u] * kv.y;
                }
            }
            uint dist = pc.pos - t;
            float rb = 0.0;
            if (dist < pc.n_extent) {
                uint rbo = dist * pc.n_rel;
                for (uint j = 0u; j < pc.n_rel; j++) rb += rbias[rbo + j] * sr[j];
            }
            sc = dot * scale + rb - sink_t;
        }
        smax[tid] = sc;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) smax[tid] = max(smax[tid], smax[tid + s]); barrier(); }
        float m_new = max(m_run, smax[0]);
        float p = (tid < tile_len) ? exp(sc - m_new) : 0.0;
        tile_p[tid] = p;
        ssum[tid] = p;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (tid < s) ssum[tid] += ssum[tid + s]; barrier(); }
        float alpha = exp(m_run - m_new);
        l_run = l_run * alpha + ssum[0];
        m_run = m_new;
        acc *= alpha;
        for (uint j = 0u; j < tile_len; j++) {
            uint t = t_start + base + j;
            uint sp = (pc.is_swa != 0u) ? (t % pc.cap) : t;
            float vv;
            if (t == pc.pos) {
                vv = v_cur_val;
            } else {
                vec2 vp = unpackHalf2x16(vcache[pc.kv_slot_off + sp * half_kv_dim + kvh * half_hd + d2]);
                vv = (lane == 0u) ? vp.x : vp.y;
            }
            acc += tile_p[j] * vv;
        }
        barrier(); // smax/ssum/tile_p are reused by the next tile
    }
    acc /= l_run;
    float gv = 1.0 / (1.0 + exp(-gate[pc.g_off + h * pc.hd + tid]));
    o[h * pc.hd + tid] = acc * gv;
}
