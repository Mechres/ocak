#version 460
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 32, local_size_y = 4) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint w_off; uint x_off; uint y_off; uint k; uint m; uint row_bytes; } pc;
void get_scale_min_k4(uint j, uint sb, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = uint(w[sb + j]) & 63u;
        mn = uint(w[sb + j + 4u]) & 63u;
    } else {
        sc = (uint(w[sb + j + 4u]) & 0xFu) | ((uint(w[sb + j - 4u]) >> 6) << 4);
        mn = (uint(w[sb + j + 4u]) >> 4) | ((uint(w[sb + j]) >> 6) << 4);
    }
}
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.x * 4u + ly;
    float acc = 0.0;
    if (row < pc.m) {
        uint rbase = pc.w_off + row * pc.row_bytes;
        uint nsub = pc.k / 32u;
        for (uint sb = tid; sb < nsub; sb += 32u) {
            uint blk = sb >> 3;
            uint j = sb & 7u;
            uint b = rbase + blk * 144u;
            float d = unpackHalf2x16(uint(w[b]) | (uint(w[b + 1u]) << 8)).x;
            float dmin = unpackHalf2x16(uint(w[b + 2u]) | (uint(w[b + 3u]) << 8)).x;
            uint sc, mn;
            get_scale_min_k4(j, b + 4u, sc, mn);
            uint qoff = b + 16u + (j >> 1) * 32u;
            uint shift = (j & 1u) * 4u;
            uint xb = pc.x_off + sb * 32u;
            float s = 0.0, sx = 0.0;
            for (uint l = 0u; l < 32u; l += 4u) {
                float x0 = x[xb + l], x1 = x[xb + l + 1u], x2 = x[xb + l + 2u], x3 = x[xb + l + 3u];
                s += float((uint(w[qoff + l]) >> shift) & 0xFu) * x0
                   + float((uint(w[qoff + l + 1u]) >> shift) & 0xFu) * x1
                   + float((uint(w[qoff + l + 2u]) >> shift) & 0xFu) * x2
                   + float((uint(w[qoff + l + 3u]) >> shift) & 0xFu) * x3;
                sx += x0 + x1 + x2 + x3;
            }
            acc += (d * float(sc)) * s - (dmin * float(mn)) * sx;
        }
    }
    float s_out = subgroupClusteredAdd(acc, 32u);
    if (tid == 0u && row < pc.m) y[pc.y_off + row] = s_out;
}
