#version 460
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };
layout(set = 0, binding = 2) readonly buffer T { uint tbl[]; };
layout(push_constant) uniform PC {
    uint ty;
    uint token;
    uint out_off;
    uint k;
    uint row_bytes;
} pc;
float f16_at(uint base) {
    uint lo = uint(w[base]);
    uint hi = uint(w[base + 1]);
    return unpackHalf2x16(lo | (hi << 8)).x;
}
void get_scale_min_k4(uint j, uint sbase, out uint sc, out uint mn) {
    if (j < 4) {
        sc = uint(w[sbase + j]) & 63u;
        mn = uint(w[sbase + j + 4]) & 63u;
    } else {
        sc = (uint(w[sbase + j + 4]) & 0xFu) | ((uint(w[sbase + j - 4]) >> 6) << 4);
        mn = (uint(w[sbase + j + 4]) >> 4) | ((uint(w[sbase + j]) >> 6) << 4);
    }
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.k) return;
    uint rbase = pc.token * pc.row_bytes;
    float val = 0.0;
    if (pc.ty == 0u) { // F32
        uint b = rbase + i * 4u;
        uint bits = uint(w[b]) | (uint(w[b+1]) << 8) | (uint(w[b+2]) << 16) | (uint(w[b+3]) << 24);
        val = uintBitsToFloat(bits);
    } else if (pc.ty == 1u) { // F16
        val = f16_at(rbase + i * 2u);
    } else if (pc.ty == 2u) { // Q4_0
        uint blk = i / 32u;
        uint sub = i % 32u;
        uint b = rbase + blk * 18u;
        float d = f16_at(b);
        uint q = (sub < 16u) ? (uint(w[b + 2u + sub]) & 0xFu) : (uint(w[b + 2u + (sub - 16u)]) >> 4);
        val = float(int(q) - 8) * d;
    } else if (pc.ty == 8u) { // Q8_0
        uint blk = i / 32u;
        uint sub = i % 32u;
        uint b = rbase + blk * 34u;
        float d = f16_at(b);
        int q = int(w[b + 2u + sub]);
        if (q >= 128) q -= 256;
        val = float(q) * d;
    } else if (pc.ty == 10u) { // Q2_K
        uint blk = i / 256u;
        uint sub = i % 256u;
        uint b = rbase + blk * 84u;
        float d = f16_at(b + 80u);
        float dmin = f16_at(b + 82u);
        uint half_i = sub / 128u;
        uint rem = sub % 128u;
        uint g = rem / 32u;
        uint rem32 = rem % 32u;
        uint is = half_i * 8u + g * 2u + (rem32 / 16u);
        uint sc = uint(w[b + is]);
        uint shift = g * 2u;
        uint qbyte = uint(w[b + 16u + half_i * 32u + rem32]);
        uint q = (qbyte >> shift) & 3u;
        val = d * float(sc & 0xFu) * float(q) - dmin * float(sc >> 4);
    } else if (pc.ty == 12u) { // Q4_K
        uint blk = i / 256u;
        uint sub = i % 256u;
        uint b = rbase + blk * 144u;
        float d = f16_at(b);
        float dmin = f16_at(b + 2u);
        uint g = sub / 64u;
        uint rem = sub % 64u;
        uint is = (rem < 32u) ? (2u * g) : (2u * g + 1u);
        uint l = rem % 32u;
        uint sc, mn;
        get_scale_min_k4(is, b + 4u, sc, mn);
        uint qb = uint(w[b + 16u + g * 32u + l]);
        uint q = (rem < 32u) ? (qb & 0xFu) : (qb >> 4);
        val = d * float(sc) * float(q) - dmin * float(mn);
    } else if (pc.ty == 13u) { // Q5_K
        uint blk = i / 256u;
        uint sub = i % 256u;
        uint b = rbase + blk * 176u;
        float d = f16_at(b);
        float dmin = f16_at(b + 2u);
        uint g = sub / 64u;
        uint rem = sub % 64u;
        uint is = (rem < 32u) ? (2u * g) : (2u * g + 1u);
        uint l = rem % 32u;
        uint sc, mn;
        get_scale_min_k4(is, b + 4u, sc, mn);
        uint qh_byte = uint(w[b + 16u + l]);
        uint qb = uint(w[b + 48u + g * 32u + l]);
        uint mask = (rem < 32u) ? (1u << (g * 2u)) : (2u << (g * 2u));
        uint q = ((rem < 32u) ? (qb & 0xFu) : (qb >> 4)) + (((qh_byte & mask) != 0u) ? 16u : 0u);
        val = d * float(sc) * float(q) - dmin * float(mn);
    } else if (pc.ty == 14u) { // Q6_K
        uint blk = i / 256u;
        uint sub = i % 256u;
        uint b = rbase + blk * 210u;
        float d = f16_at(b + 208u);
        uint half_i = sub / 128u;
        uint rem = sub % 128u;
        uint quarter = rem / 32u;
        uint l = rem % 32u;
        uint is = l / 16u;
        uint ql_off = b + half_i * 64u;
        uint qh_off = b + 128u + half_i * 32u;
        uint sc_off = b + 192u + half_i * 8u;
        uint qh_b = uint(w[qh_off + l]);
        uint q = 0u;
        uint sc_i = 0u;
        if (quarter == 0u) { q = (uint(w[ql_off + l]) & 0xFu) | ((qh_b & 3u) << 4); sc_i = is; }
        else if (quarter == 1u) { q = (uint(w[ql_off + l + 32u]) & 0xFu) | (((qh_b >> 2) & 3u) << 4); sc_i = is + 2u; }
        else if (quarter == 2u) { q = (uint(w[ql_off + l]) >> 4) | (((qh_b >> 4) & 3u) << 4); sc_i = is + 4u; }
        else { q = (uint(w[ql_off + l + 32u]) >> 4) | (((qh_b >> 6) & 3u) << 4); sc_i = is + 6u; }
        int scv = int(w[sc_off + sc_i]);
        if (scv >= 128) scv -= 256;
        val = d * float(scv) * float(int(q) - 32);
    } else if (pc.ty == 21u) { // IQ3_S
        uint blk = i / 256u;
        uint sub = i % 256u;
        uint b = rbase + blk * 110u;
        float d = f16_at(b);
        uint ib32 = sub / 32u;
        uint rem32 = sub % 32u;
        uint l = rem32 / 8u;
        uint j = rem32 % 8u;
        uint sc = uint(w[b + 106u + ib32 / 2u]);
        float db = d * float(1u + 2u * (((ib32 & 1u) == 0u) ? (sc & 0xFu) : (sc >> 4)));
        uint qh = uint(w[b + 66u + ib32]);
        uint qs_off = b + 2u + ib32 * 8u;
        uint sg = uint(w[b + 74u + ib32 * 4u + l]);
        uint idx = (j < 4u)
            ? (uint(w[qs_off + 2u * l]) | ((qh << (8u - 2u * l)) & 256u))
            : (uint(w[qs_off + 2u * l + 1u]) | ((qh << (7u - 2u * l)) & 256u));
        uint g = tbl[1280u + idx];
        uint gv = (g >> (8u * (j & 3u))) & 0xFFu;
        val = db * float(gv) * (((sg & (1u << j)) != 0u) ? -1.0 : 1.0);
    }
    o[pc.out_off + i] = val;
}
