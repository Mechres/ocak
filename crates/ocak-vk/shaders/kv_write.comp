#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer K { float k[]; };
layout(set = 0, binding = 1) readonly buffer V { float v[]; };
layout(set = 0, binding = 2) writeonly buffer KV { float kv[]; };
layout(set = 0, binding = 3) readonly buffer PT { uint pt[]; };
layout(push_constant) uniform PC {
    uint k_off;
    uint v_off;
    uint layer_kv_off;
    uint pt_off;
    uint pos;
    uint kv_dim;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.kv_dim) return;
    uint page = pt[pc.pt_off + (pc.pos >> 4)];
    uint slot = pc.pos & 15u;
    uint ko = pc.layer_kv_off + ((page * 2u + 0u) * 16u + slot) * pc.kv_dim + i;
    uint vo = pc.layer_kv_off + ((page * 2u + 1u) * 16u + slot) * pc.kv_dim + i;
    kv[ko] = k[pc.k_off + i];
    kv[vo] = v[pc.v_off + i];
}
