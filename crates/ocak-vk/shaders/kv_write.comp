#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer K { float k[]; };
layout(set = 0, binding = 1) readonly buffer V { float v[]; };
layout(set = 0, binding = 2) writeonly buffer KV { uint kv[]; };
layout(set = 0, binding = 3) readonly buffer PT { uint pt[]; };
layout(push_constant) uniform PC {
    uint k_off;
    uint v_off;
    uint layer_kv_off;
    uint pt_off;
    uint pos;
    uint kv_dim;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint half_dim = pc.kv_dim >> 1;
    if (i >= half_dim) return;
    uint tok = gl_WorkGroupID.y;  // batched: token index
    uint pos = pc.pos + tok;
    uint koff = pc.k_off + tok * pc.kv_dim;
    uint voff = pc.v_off + tok * pc.kv_dim;
    uint page = pt[pc.pt_off + (pos >> 4)];
    uint slot = pos & 15u;
    uint ko = pc.layer_kv_off + ((page * 2u + 0u) * 16u + slot) * half_dim + i;
    uint vo = pc.layer_kv_off + ((page * 2u + 1u) * 16u + slot) * half_dim + i;
    kv[ko] = packHalf2x16(vec2(k[koff + 2u * i], k[koff + 2u * i + 1u]));
    kv[vo] = packHalf2x16(vec2(v[voff + 2u * i], v[voff + 2u * i + 1u]));
}
