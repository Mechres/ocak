#version 460
// Causal depthwise conv + SiLU over `batch` tokens. One thread per channel; the d_conv-tap
// history lives in registers across the token loop (written back once at the end).
#define MAXD 8u
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { float cw[]; };
layout(set = 0, binding = 2) buffer ST { float st[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint channels; uint k_conv; uint batch; } pc;
void main() {
    uint ch = gl_GlobalInvocationID.x;
    if (ch >= pc.channels) return;
    uint d_conv = pc.k_conv - 1u;
    uint sb = ch * d_conv;
    uint wb = ch * pc.k_conv;
    float h[MAXD];
    float w[MAXD + 1u];
    for (uint t = 0u; t < MAXD; t++) h[t] = (t < d_conv) ? st[sb + t] : 0.0;
    for (uint t = 0u; t <= MAXD; t++) w[t] = (t <= d_conv) ? cw[wb + t] : 0.0;
    for (uint ti = 0u; ti < pc.batch; ti++) {
        float xv = x[ti * pc.channels + ch];
        float acc = xv * w[d_conv];
        for (uint t = 0u; t < MAXD; t++) if (t < d_conv) acc += h[t] * w[t];
        for (uint t = 0u; t + 1u < MAXD; t++) if (t + 1u < d_conv) h[t] = h[t + 1u];
        for (uint t = 0u; t < MAXD; t++) if (t == d_conv - 1u) h[t] = xv;
        o[ti * pc.channels + ch] = acc / (1.0 + exp(-acc));
    }
    for (uint t = 0u; t < MAXD; t++) if (t < d_conv) st[sb + t] = h[t];
}
