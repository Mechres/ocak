#version 460
// LFM2-style gated short conv over `batch` tokens: o = c * conv(b * x). One thread per channel;
// the d_conv-tap history lives in registers across the token loop (written back once at the end).
#define MAXD 8u
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer BCX { float bcx[]; };
layout(set = 0, binding = 1) readonly buffer W { float cw[]; };
layout(set = 0, binding = 2) buffer ST { float st[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n_embd; uint l_cache; uint batch; } pc;
void main() {
    uint e = gl_GlobalInvocationID.x;
    if (e >= pc.n_embd) return;
    uint d_conv = pc.l_cache - 1u;
    uint sb = e * d_conv;
    uint wb = e * pc.l_cache;
    float h[MAXD];
    float w[MAXD + 1u];
    for (uint t = 0u; t < MAXD; t++) h[t] = (t < d_conv) ? st[sb + t] : 0.0;
    for (uint t = 0u; t <= MAXD; t++) w[t] = (t <= d_conv) ? cw[wb + t] : 0.0;
    for (uint ti = 0u; ti < pc.batch; ti++) {
        uint bo = ti * 3u * pc.n_embd;
        float bx = bcx[bo + e] * bcx[bo + 2u * pc.n_embd + e];
        float c = bcx[bo + pc.n_embd + e];
        float acc = bx * w[d_conv];
        for (uint t = 0u; t < MAXD; t++) if (t < d_conv) acc += h[t] * w[t];
        for (uint t = 0u; t + 1u < MAXD; t++) if (t + 1u < d_conv) h[t] = h[t + 1u];
        for (uint t = 0u; t < MAXD; t++) if (t == d_conv - 1u) h[t] = bx;
        o[ti * pc.n_embd + e] = c * acc;
    }
    for (uint t = 0u; t < MAXD; t++) if (t < d_conv) st[sb + t] = h[t];
}
