#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer S { float s[]; };
layout(set = 0, binding = 1) writeonly buffer D { float d[]; };
layout(push_constant) uniform PC { uint s_off; uint d_off; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) d[pc.d_off + i] = s[pc.s_off + i];
}
