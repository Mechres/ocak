#version 460
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 32, local_size_y = 8) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint w_off; uint x_off; uint y_off; uint k; uint m; uint row_bytes; uint batch; } pc;
shared float sx[8][256];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint lid = ly * 32u + tid;
    uint row = gl_WorkGroupID.x * 8u + ly;
    uint b0 = gl_WorkGroupID.y * 8u;
    uint bm = pc.batch - 1u;
    uint o0 = pc.x_off + b0 * pc.k;
    uint o1 = pc.x_off + min(b0 + 1u, bm) * pc.k;
    uint o2 = pc.x_off + min(b0 + 2u, bm) * pc.k;
    uint o3 = pc.x_off + min(b0 + 3u, bm) * pc.k;
    uint o4 = pc.x_off + min(b0 + 4u, bm) * pc.k;
    uint o5 = pc.x_off + min(b0 + 5u, bm) * pc.k;
    uint o6 = pc.x_off + min(b0 + 6u, bm) * pc.k;
    uint o7 = pc.x_off + min(b0 + 7u, bm) * pc.k;
    vec4 acc0 = vec4(0.0), acc1 = vec4(0.0);
    uint rbase = pc.w_off + row * pc.row_bytes;
    uint nb = pc.k / 256u;
    uint is = tid >> 4;
    for (uint blk = 0u; blk < nb; blk++) {
        uint xidx = blk * 256u + lid;
        sx[0][lid] = x[o0 + xidx];
        sx[1][lid] = x[o1 + xidx];
        sx[2][lid] = x[o2 + xidx];
        sx[3][lid] = x[o3 + xidx];
        sx[4][lid] = x[o4 + xidx];
        sx[5][lid] = x[o5 + xidx];
        sx[6][lid] = x[o6 + xidx];
        sx[7][lid] = x[o7 + xidx];
        barrier();
        if (row < pc.m) {
            uint b = rbase + blk * 210u;
            float d = unpackHalf2x16(uint(w[b + 208u]) | (uint(w[b + 209u]) << 8)).x;
            for (uint half_i = 0u; half_i < 2u; half_i++) {
                uint ql_base = b + half_i * 64u;
                uint qh_base = b + 128u + half_i * 32u;
                uint sc_base = b + 192u + half_i * 8u;
                uint ql0 = uint(w[ql_base + tid]);
                uint ql1 = uint(w[ql_base + 32u + tid]);
                uint qh = uint(w[qh_base + tid]);
                float sc0 = d * float(bitfieldExtract(int(w[sc_base + is]), 0, 8));
                float sc1 = d * float(bitfieldExtract(int(w[sc_base + 2u + is]), 0, 8));
                float sc2 = d * float(bitfieldExtract(int(w[sc_base + 4u + is]), 0, 8));
                float sc3 = d * float(bitfieldExtract(int(w[sc_base + 6u + is]), 0, 8));
                float w0 = sc0 * float(int((ql0 & 0xFu) | ((qh & 3u) << 4)) - 32);
                float w1 = sc1 * float(int((ql1 & 0xFu) | (((qh >> 2) & 3u) << 4)) - 32);
                float w2 = sc2 * float(int((ql0 >> 4) | (((qh >> 4) & 3u) << 4)) - 32);
                float w3 = sc3 * float(int((ql1 >> 4) | (((qh >> 6) & 3u) << 4)) - 32);
                uint i0 = half_i * 128u + tid;
                acc0 += w0 * vec4(sx[0][i0], sx[1][i0], sx[2][i0], sx[3][i0]);
                acc1 += w0 * vec4(sx[4][i0], sx[5][i0], sx[6][i0], sx[7][i0]);
                uint i1 = i0 + 32u;
                acc0 += w1 * vec4(sx[0][i1], sx[1][i1], sx[2][i1], sx[3][i1]);
                acc1 += w1 * vec4(sx[4][i1], sx[5][i1], sx[6][i1], sx[7][i1]);
                uint i2 = i0 + 64u;
                acc0 += w2 * vec4(sx[0][i2], sx[1][i2], sx[2][i2], sx[3][i2]);
                acc1 += w2 * vec4(sx[4][i2], sx[5][i2], sx[6][i2], sx[7][i2]);
                uint i3 = i0 + 96u;
                acc0 += w3 * vec4(sx[0][i3], sx[1][i3], sx[2][i3], sx[3][i3]);
                acc1 += w3 * vec4(sx[4][i3], sx[5][i3], sx[6][i3], sx[7][i3]);
            }
        }
        barrier();
    }
    vec4 r0 = subgroupClusteredAdd(acc0, 32u);
    vec4 r1 = subgroupClusteredAdd(acc1, 32u);
    if (tid == 0u && row < pc.m) {
        y[pc.y_off + b0 * pc.m + row] = r0.x;
        if (b0 + 1u < pc.batch) y[pc.y_off + (b0 + 1u) * pc.m + row] = r0.y;
        if (b0 + 2u < pc.batch) y[pc.y_off + (b0 + 2u) * pc.m + row] = r0.z;
        if (b0 + 3u < pc.batch) y[pc.y_off + (b0 + 3u) * pc.m + row] = r0.w;
        if (b0 + 4u < pc.batch) y[pc.y_off + (b0 + 4u) * pc.m + row] = r1.x;
        if (b0 + 5u < pc.batch) y[pc.y_off + (b0 + 5u) * pc.m + row] = r1.y;
        if (b0 + 6u < pc.batch) y[pc.y_off + (b0 + 6u) * pc.m + row] = r1.z;
        if (b0 + 7u < pc.batch) y[pc.y_off + (b0 + 7u) * pc.m + row] = r1.w;
    }
}
