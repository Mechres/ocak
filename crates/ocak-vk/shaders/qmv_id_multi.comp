#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_GOOGLE_include_directive : require
// MoE expert matvec for any weight format: workgroup y = routed slot s; expert ids[slot + s]
// selects weight slice `expert * slice_bytes`; reads X at x_off + s * x_stride and writes
// Y at y_off + s * m. Same push-constant layout as the hand-written qmv_*_id shaders.
layout(local_size_x = 32, local_size_y = 4) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 3) readonly buffer T { uint tbl[]; };
layout(set = 0, binding = 4) readonly buffer Ids { uint ids[]; };
layout(push_constant) uniform PC { uint slot; uint x_off; uint y_off; uint k; uint m; uint row_bytes; uint slice_bytes; uint x_stride; } pc;

#include "dequant8.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    uint s = gl_WorkGroupID.y;
    float acc = 0.0;
    if (row < pc.m) {
        uint rb = ids[pc.slot + s] * pc.slice_bytes + row * pc.row_bytes;
        uint xb = pc.x_off + s * pc.x_stride;
        for (uint k0 = tid * 8u; k0 < pc.k; k0 += 256u) {
            float v[8];
            dq8(rb, k0, v);
            float t = 0.0;
            for (uint i = 0u; i < 8u; i++) t += v[i] * x[xb + k0 + i];
            acc += t;
        }
    }
    float r = subgroupClusteredAdd(acc, 32u);
    if (tid == 0u && row < pc.m) y[pc.y_off + s * pc.m + row] = r;
}
