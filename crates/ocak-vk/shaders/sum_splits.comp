#version 460
// y[y_off + i] = sum over s < splits of p[p_off + s * n + i] (split-K partial results).
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer P { float p[]; };
layout(set = 0, binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint p_off; uint y_off; uint n; uint splits; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float acc = 0.0;
    for (uint s = 0u; s < pc.splits; s++) acc += p[pc.p_off + s * pc.n + i];
    y[pc.y_off + i] = acc;
}
