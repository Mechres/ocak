#version 460
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 32, local_size_y = 4) in;
layout(set = 0, binding = 0) readonly buffer W { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 3) readonly buffer T { uint tbl[]; };
layout(push_constant) uniform PC { uint w_off; uint x_off; uint y_off; uint k; uint m; uint row_bytes; } pc;
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.x * 4u + ly;
    float acc = 0.0;
    if (row < pc.m) {
        uint rbase = pc.w_off + row * pc.row_bytes;
        uint nblk = pc.k / 256u;
        for (uint blk = tid; blk < nblk; blk += 32u) {
            uint b = rbase + blk * 110u;
            float d = unpackHalf2x16(uint(w[b]) | (uint(w[b+1]) << 8)).x;
            uint xb = pc.x_off + blk * 256u;
            for (uint ib32 = 0u; ib32 < 8u; ib32 += 2u) {
                uint sc = uint(w[b + 106u + ib32 / 2u]);
                float db1 = d * float(1u + 2u * (sc & 0xFu));
                float db2 = d * float(1u + 2u * (sc >> 4));
                uint qh0 = uint(w[b + 66u + ib32]);
                uint qh1 = uint(w[b + 66u + ib32 + 1u]);
                uint qs0 = b + 2u + ib32 * 8u;
                uint sg0 = b + 74u + ib32 * 4u;
                for (uint l = 0u; l < 4u; l++) {
                    uint i1 = uint(w[qs0 + 2u * l]) | ((qh0 << (8u - 2u * l)) & 256u);
                    uint i2 = uint(w[qs0 + 2u * l + 1u]) | ((qh0 << (7u - 2u * l)) & 256u);
                    uint g1 = tbl[1280u + i1];
                    uint g2 = tbl[1280u + i2];
                    uint sg = uint(w[sg0 + l]);
                    uint xo = xb + ib32 * 32u + l * 8u;
                    float s = 0.0;
                    for (uint j = 0u; j < 4u; j++) {
                        s += float((g1 >> (8u * j)) & 0xFFu) * (((sg & (1u << j)) != 0u) ? -1.0 : 1.0) * x[xo + j];
                        s += float((g2 >> (8u * j)) & 0xFFu) * (((sg & (1u << (j + 4u))) != 0u) ? -1.0 : 1.0) * x[xo + j + 4u];
                    }
                    acc += db1 * s;
                }
                uint qs1 = qs0 + 8u;
                uint sg1 = sg0 + 4u;
                for (uint l = 0u; l < 4u; l++) {
                    uint i1 = uint(w[qs1 + 2u * l]) | ((qh1 << (8u - 2u * l)) & 256u);
                    uint i2 = uint(w[qs1 + 2u * l + 1u]) | ((qh1 << (7u - 2u * l)) & 256u);
                    uint g1 = tbl[1280u + i1];
                    uint g2 = tbl[1280u + i2];
                    uint sg = uint(w[sg1 + l]);
                    uint xo = xb + (ib32 + 1u) * 32u + l * 8u;
                    float s = 0.0;
                    for (uint j = 0u; j < 4u; j++) {
                        s += float((g1 >> (8u * j)) & 0xFFu) * (((sg & (1u << j)) != 0u) ? -1.0 : 1.0) * x[xo + j];
                        s += float((g2 >> (8u * j)) & 0xFFu) * (((sg & (1u << (j + 4u))) != 0u) ? -1.0 : 1.0) * x[xo + j + 4u];
                    }
                    acc += db2 * s;
                }
            }
        }
    }
    float s_out = subgroupClusteredAdd(acc, 32u);
    if (tid == 0u && row < pc.m) y[pc.y_off + row] = s_out;
}
