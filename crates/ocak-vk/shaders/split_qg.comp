#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer QG { float qg[]; };
layout(set = 0, binding = 1) writeonly buffer Q { float q[]; };
layout(set = 0, binding = 2) writeonly buffer G { float g[]; };
layout(push_constant) uniform PC { uint n_heads; uint head_dim; } pc;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.n_heads * pc.head_dim;
    if (idx >= total) return;
    uint b = gl_WorkGroupID.y;
    uint h = idx / pc.head_dim;
    uint d = idx % pc.head_dim;
    q[b * total + idx] = qg[b * 2u * total + h * 2u * pc.head_dim + d];
    g[b * total + idx] = qg[b * 2u * total + (h * 2u + 1u) * pc.head_dim + d];
}
