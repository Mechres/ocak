#version 460
#extension GL_KHR_shader_subgroup_clustered : require
// Flash-attention style causal prefill over the paged FP16 KV cache.
// Workgroup (kvh, tile) owns R = 64 query rows: the `group` query heads that share KV head kvh,
// for 64 / group consecutive tokens. Each step stages a BK-key tile of K and V in shared memory
// once and reuses it for all 64 rows (vs. one full KV pass per (head, token) in attention.comp).
// Thread layout: row r = tid / 4; the 4 lanes of a row split the keys (scores) and the output dims.
// Compiled with HDMAX = 128 or 256 (max head_dim).
#ifndef HDMAX
#define HDMAX 128
#endif
#if HDMAX > 128
#define BK 16u
#else
#define BK 32u
#endif
#define R 64u
#define HHD (uint(HDMAX) / 2u)   // packed f16x2 per row
#define KPT (BK / 4u)      // keys per lane
#define DPT (HHD / 4u)     // packed output dims per lane
#define HS (HHD + 1u)      // padded shared row stride (rows land in different banks)
#define KP2 (BK / 8u)      // keys per lane (8 lanes per row pair)
#define DP2 (HHD / 8u)     // packed output dims per lane
#define PS (BK + 1u)       // padded P row stride
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer KV { uint kv[]; };
layout(set = 0, binding = 2) readonly buffer PT { uint pt[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC {
    uint q_off;
    uint layer_kv_off;
    uint pt_off;
    uint out_off;
    uint n_heads;
    uint n_kv_heads;
    uint head_dim;
    uint pos0;
    uint sliding_window;
    uint n_tok;
} pc;

shared uint qs[R * HS];
shared uint ks[BK * HS];
shared uint vs[BK * HS];
shared float ps[R * PS];

void main() {
    uint kvh = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint group = pc.n_heads / pc.n_kv_heads;
    uint bq = R / group;
    uint q0 = gl_WorkGroupID.y * bq;
    uint hhd = pc.head_dim >> 1;
    uint half_kv_dim = pc.n_kv_heads * hhd;
    float scale = inversesqrt(float(pc.head_dim));

    // Stage the 64 query rows (pre-scaled) as packed f16.
    for (uint idx = tid; idx < R * hhd; idx += 256u) {
        uint r = idx / hhd;
        uint e = idx % hhd;
        uint tok = q0 + r / group;
        uint h = kvh * group + r % group;
        vec2 v = vec2(0.0);
        if (tok < pc.n_tok) {
            uint qb = pc.q_off + (tok * pc.n_heads + h) * pc.head_dim + 2u * e;
            v = vec2(q[qb], q[qb + 1u]) * scale;
        }
        qs[r * HS + e] = packHalf2x16(v);
    }

    // Thread = (row pair rp, sub): rows 2 rp and 2 rp + 1; the 8 lanes of a row pair split the
    // keys (scores, key = sub + 8 j) and the packed output dims (dim = sub + 8 j), so each K / V
    // word read from shared memory serves two query rows.
    uint rp = tid >> 3;
    uint sub = tid & 7u;
    uint ra = 2u * rp;
    uint rb = ra + 1u;
    uint tok_a = q0 + ra / group;
    uint tok_b = q0 + rb / group;
    bool valid_a = tok_a < pc.n_tok;
    bool valid_b = tok_b < pc.n_tok;
    uint qpos_a = pc.pos0 + tok_a;
    uint qpos_b = pc.pos0 + tok_b;
    uint ntq = min(bq, pc.n_tok - q0);
    uint max_qpos = pc.pos0 + q0 + ntq - 1u;
    uint min_qpos = pc.pos0 + q0;
    uint t_lo = (pc.sliding_window > 0u && min_qpos + 1u > pc.sliding_window) ? (min_qpos + 1u - pc.sliding_window) : 0u;
    t_lo = (t_lo / BK) * BK;

    float ma = -1e30, mb = -1e30;
    float la = 0.0, lb = 0.0;
    vec2 acca[DP2];
    vec2 accb[DP2];
    for (uint j = 0u; j < DP2; j++) { acca[j] = vec2(0.0); accb[j] = vec2(0.0); }
    barrier();

    // K/V tile staging with a register prefetch of the next tile (loads in flight during compute).
    #define LPT ((BK * HHD) / 256u)
    uint pk[LPT];
    uint pv[LPT];
    for (uint u = 0u; u < LPT; u++) {
        uint idx = tid + 256u * u;
        uint kk = idx / hhd;
        uint e = idx % hhd;
        uint t = t_lo + kk;
        pk[u] = 0u; pv[u] = 0u;
        if (idx < BK * hhd && t <= max_qpos) {
            uint kb = pc.layer_kv_off + ((pt[pc.pt_off + (t >> 4)] * 2u) * 16u + (t & 15u)) * half_kv_dim + kvh * hhd + e;
            pk[u] = kv[kb];
            pv[u] = kv[kb + 16u * half_kv_dim];
        }
    }
    for (uint t0 = t_lo; t0 <= max_qpos; t0 += BK) {
        for (uint u = 0u; u < LPT; u++) {
            uint idx = tid + 256u * u;
            if (idx < BK * hhd) {
                uint kk = idx / hhd;
                uint e = idx % hhd;
                ks[kk * HS + e] = pk[u];
                vs[kk * HS + e] = pv[u];
            }
        }
        barrier();
        uint t1 = t0 + BK;
        if (t1 <= max_qpos) {
            for (uint u = 0u; u < LPT; u++) {
                uint idx = tid + 256u * u;
                uint kk = idx / hhd;
                uint e = idx % hhd;
                uint t = t1 + kk;
                pk[u] = 0u; pv[u] = 0u;
                if (idx < BK * hhd && t <= max_qpos) {
                    uint kb = pc.layer_kv_off + ((pt[pc.pt_off + (t >> 4)] * 2u) * 16u + (t & 15u)) * half_kv_dim + kvh * hhd + e;
                    pk[u] = kv[kb];
                    pv[u] = kv[kb + 16u * half_kv_dim];
                }
            }
        }

        float sa[KP2];
        float sb[KP2];
        for (uint j = 0u; j < KP2; j++) { sa[j] = 0.0; sb[j] = 0.0; }
        for (uint e = 0u; e < hhd; e++) {
            vec2 qa = unpackHalf2x16(qs[ra * HS + e]);
            vec2 qb = unpackHalf2x16(qs[rb * HS + e]);
            for (uint j = 0u; j < KP2; j++) {
                vec2 kv2 = unpackHalf2x16(ks[(sub + 8u * j) * HS + e]);
                sa[j] += dot(qa, kv2);
                sb[j] += dot(qb, kv2);
            }
        }
        float tma = -1e30, tmb = -1e30;
        for (uint j = 0u; j < KP2; j++) {
            uint t = t0 + sub + 8u * j;
            bool oka = valid_a && t <= qpos_a && (pc.sliding_window == 0u || qpos_a - t < pc.sliding_window);
            bool okb = valid_b && t <= qpos_b && (pc.sliding_window == 0u || qpos_b - t < pc.sliding_window);
            sa[j] = oka ? sa[j] : -3.0e38;
            sb[j] = okb ? sb[j] : -3.0e38;
            tma = max(tma, sa[j]);
            tmb = max(tmb, sb[j]);
        }
        tma = subgroupClusteredMax(tma, 8u);
        tmb = subgroupClusteredMax(tmb, 8u);
        float mna = max(ma, tma), mnb = max(mb, tmb);
        float ala = exp(ma - mna), alb = exp(mb - mnb);
        float psa = 0.0, psb = 0.0;
        for (uint j = 0u; j < KP2; j++) {
            float pa = (sa[j] > -1.0e38) ? exp(sa[j] - mna) : 0.0;
            float pb = (sb[j] > -1.0e38) ? exp(sb[j] - mnb) : 0.0;
            ps[ra * PS + sub + 8u * j] = pa;
            ps[rb * PS + sub + 8u * j] = pb;
            psa += pa;
            psb += pb;
        }
        psa = subgroupClusteredAdd(psa, 8u);
        psb = subgroupClusteredAdd(psb, 8u);
        la = la * ala + psa;
        lb = lb * alb + psb;
        ma = mna;
        mb = mnb;
        for (uint j = 0u; j < DP2; j++) { acca[j] *= ala; accb[j] *= alb; }
        barrier();

        for (uint kk = 0u; kk < BK; kk++) {
            float pa = ps[ra * PS + kk];
            float pb = ps[rb * PS + kk];
            for (uint j = 0u; j < DP2; j++) {
                vec2 v = unpackHalf2x16(vs[kk * HS + sub + 8u * j]);
                acca[j] += pa * v;
                accb[j] += pb * v;
            }
        }
        barrier();
    }

    for (uint w = 0u; w < 2u; w++) {
        uint r = ra + w;
        uint tok_r = (w == 0u) ? tok_a : tok_b;
        if (tok_r >= pc.n_tok) continue;
        uint h = kvh * group + r % group;
        float inv = 1.0 / ((w == 0u) ? la : lb);
        uint ob = pc.out_off + (tok_r * pc.n_heads + h) * pc.head_dim;
        for (uint j = 0u; j < DP2; j++) {
            uint d2 = sub + 8u * j;
            vec2 a = (w == 0u) ? acca[j] : accb[j];
            if (d2 < hhd) {
                o[ob + 2u * d2] = a.x * inv;
                o[ob + 2u * d2 + 1u] = a.y * inv;
            }
        }
    }
}
