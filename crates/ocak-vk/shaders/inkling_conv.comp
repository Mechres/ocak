#version 460
// Causal short convolution (+ optional per-head dynamic taps) over n_tok consecutive tokens.
// One thread per channel walks the tokens in order, keeping the (n_conv - 1)-entry history in
// registers, and writes the history back at the end. Token t reads inp row t * inp_stride, dyn
// row t * dy_stride and writes out row t * out_stride.
#define MAXH 8u
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Inp { float inp[]; };
layout(set = 0, binding = 1) readonly buffer Weight { float wt[]; };
layout(set = 0, binding = 2) readonly buffer Dyn { float dy[]; };
layout(set = 0, binding = 3) buffer Hist { float hist[]; };
layout(set = 0, binding = 4) writeonly buffer Out { float o[]; };
layout(push_constant) uniform PC {
    uint inp_off;
    uint dy_off;
    uint hist_off;
    uint out_off;
    uint n_ch;
    uint n_conv;
    uint has_dyn;
    uint head_ch;
    uint n_tok;
    uint inp_stride;
    uint dy_stride;
    uint out_stride;
} pc;
void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.n_ch) return;
    uint nh = pc.n_conv - 1u;
    uint ho = pc.hist_off + c * nh;
    uint wo = c * pc.n_conv;
    float h[MAXH];
    for (uint k = 0u; k < MAXH; k++) h[k] = (k < nh) ? hist[ho + k] : 0.0;
    float denom = sqrt(float(((pc.has_dyn != 0u) ? 2u : 1u) * pc.n_conv + 1u));
    uint hh = c / pc.head_ch;
    for (uint t = 0u; t < pc.n_tok; t++) {
        float cur_v = inp[pc.inp_off + t * pc.inp_stride + c];
        float acc = 0.0;
        for (uint k = 0u; k < nh; k++) acc += h[k] * wt[wo + k];
        acc += cur_v * wt[wo + nh];
        if (pc.has_dyn != 0u) {
            uint d_off = pc.dy_off + t * pc.dy_stride + hh * pc.n_conv;
            acc += cur_v * dy[d_off];
            for (uint lag = 1u; lag < pc.n_conv; lag++) acc += h[nh - lag] * dy[d_off + lag];
        }
        for (uint k = 0u; k + 1u < nh; k++) h[k] = h[k + 1u];
        h[nh - 1u] = cur_v;
        o[pc.out_off + t * pc.out_stride + c] = (cur_v + acc) / denom;
    }
    for (uint k = 0u; k < nh; k++) hist[ho + k] = h[k];
}
