#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Q { float q[]; };
layout(set = 0, binding = 1) buffer K { float k[]; };
layout(set = 0, binding = 2) readonly buffer F { float factors[]; };
layout(push_constant) uniform PC {
    uint q_off;
    uint k_off;
    uint n_heads;
    uint n_kv_heads;
    uint head_dim;
    uint n_rot;
    uint pos;
    uint mode;
    float freq_base;
    uint use_factors;
} pc;
void main() {
    uint wg = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;  // batched: token index
    uint pos = pc.pos + tok;
    uint q_off = pc.q_off + tok * pc.n_heads * pc.head_dim;
    uint k_off = pc.k_off + tok * pc.n_kv_heads * pc.head_dim;
    uint half_rot = pc.n_rot / 2u;
    for (uint i = gl_LocalInvocationID.x; i < half_rot; i += 64u) {
        float inv_f = (pc.use_factors != 0u) ? (1.0 / factors[i]) : 1.0;
        float theta = float(pos) * pow(pc.freq_base, -2.0 * float(i) / float(pc.n_rot)) * inv_f;
        float c = cos(theta);
        float s = sin(theta);
        uint a = (pc.mode == 0u) ? (2u * i) : i;
        uint b = (pc.mode == 0u) ? (2u * i + 1u) : (i + half_rot);
        if (wg < pc.n_heads) {
            uint base = q_off + wg * pc.head_dim;
            float x0 = q[base + a];
            float x1 = q[base + b];
            q[base + a] = x0 * c - x1 * s;
            q[base + b] = x0 * s + x1 * c;
        } else {
            uint h = wg - pc.n_heads;
            if (h < pc.n_kv_heads) {
                uint base = k_off + h * pc.head_dim;
                float x0 = k[base + a];
                float x1 = k[base + b];
                k[base + a] = x0 * c - x1 * s;
                k[base + b] = x0 * s + x1 * c;
            }
        }
    }
}
