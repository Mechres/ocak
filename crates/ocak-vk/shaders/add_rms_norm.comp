#version 460
#extension GL_KHR_shader_subgroup_clustered : require
// x += r; o = x * rsqrt(mean(x^2) + eps) * w. The reduction (512 threads, 32-lane clusters, 16
// partials summed in order) is identical to rms_norm.comp, so the fused decode path and the
// batched path (add + rms_norm_batch, used by MTP verification) produce the same bits.
// Workgroup y = row: rows of n floats back to back in x, r and o (batched prefill / verify).
layout(local_size_x = 512) in;
layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer R { float r[]; };
layout(set = 0, binding = 2) readonly buffer W { float w[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC {
    uint x_off;
    uint r_off;
    uint w_off;
    uint out_off;
    uint n;
    float eps;
} pc;
shared float sm[16];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.y * pc.n;
    uint xo = pc.x_off + row, ro = pc.r_off + row, oo = pc.out_off + row;
    float acc = 0.0;
    for (uint i = tid; i < pc.n; i += 512u) {
        float v = x[xo + i] + r[ro + i];
        x[xo + i] = v;
        acc += v * v;
    }
    float s32 = subgroupClusteredAdd(acc, 32u);
    if ((tid & 31u) == 0u) sm[tid >> 5] = s32;
    barrier();
    float tot = 0.0;
    for (uint j = 0u; j < 16u; j++) tot += sm[j];
    float scale = inversesqrt(tot / float(pc.n) + pc.eps);
    for (uint i = tid; i < pc.n; i += 512u) {
        o[oo + i] = x[xo + i] * scale * w[pc.w_off + i];
    }
}
