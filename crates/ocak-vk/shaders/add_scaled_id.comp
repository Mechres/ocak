#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) readonly buffer W { float w[]; };
layout(push_constant) uniform PC { uint a_off; uint b_off; uint n; uint slot; uint count; uint overwrite; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    // Batched: workgroup y = token t (a row t, b rows t*count.., weights slot + t*count..).
    uint t = gl_WorkGroupID.y;
    uint a_off = pc.a_off + t * pc.n;
    uint b_off = pc.b_off + t * pc.count * pc.n;
    uint slot = pc.slot + t * pc.count;
    float acc = (pc.overwrite != 0u) ? 0.0 : a[a_off + i];
    for (uint k = 0u; k < pc.count; k++) {
        acc += w[slot + k] * b[b_off + k * pc.n + i];
    }
    a[a_off + i] = acc;
}
