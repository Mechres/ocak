#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer G { float g[]; };
layout(set = 0, binding = 1) readonly buffer U { float u[]; };
layout(set = 0, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint g_off; uint u_off; uint o_off; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) {
        float v = g[pc.g_off + i];
        o[pc.o_off + i] = (v / (1.0 + exp(-v))) * u[pc.u_off + i];
    }
}
