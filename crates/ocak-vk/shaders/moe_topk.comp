#version 460
// MoE router: sigmoid probabilities, top-n_used experts by (probability + optional bias), output
// in descending order with weights = probability * scale (optionally normalized to sum 1 first).
// One workgroup per token, one thread per expert (n_exp <= 256): an expert's output slot is its
// rank, the number of experts with a larger biased score (ties: lower index first), which gives
// the same order as repeated argmax.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Logits { float logits[]; };
layout(set = 0, binding = 1) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 2) writeonly buffer Ids { uint ids[]; };
layout(set = 0, binding = 3) writeonly buffer Weights { float weights[]; };
layout(push_constant) uniform PC {
    uint n_exp;
    uint n_used;
    uint has_bias;
    uint norm_w;
    float scale;
} pc;
shared float sb[256];
shared float sel_p[256];
void main() {
    uint b = gl_WorkGroupID.y;
    uint e = gl_LocalInvocationID.x;
    uint lg_off = b * pc.n_exp;
    uint out_off = b * pc.n_used;
    float p = 0.0;
    if (e < pc.n_exp) {
        p = 1.0 / (1.0 + exp(-logits[lg_off + e]));
        sb[e] = p + ((pc.has_bias != 0u) ? bias[e] : 0.0);
    }
    barrier();
    uint rank = 0xFFFFFFFFu;
    if (e < pc.n_exp) {
        float v = sb[e];
        rank = 0u;
        for (uint o = 0u; o < pc.n_exp; o++) {
            float u = sb[o];
            rank += (u > v || (u == v && o < e)) ? 1u : 0u;
        }
        if (rank < pc.n_used) {
            ids[out_off + rank] = e;
            sel_p[rank] = p;
        }
    }
    barrier();
    if (rank < pc.n_used) {
        float wsum = 0.0;
        for (uint k = 0u; k < pc.n_used; k++) wsum += sel_p[k];   // same order as before
        float mult = (pc.norm_w != 0u) ? (pc.scale / (wsum + 1e-20)) : pc.scale;
        weights[out_off + rank] = p * mult;
    }
}
