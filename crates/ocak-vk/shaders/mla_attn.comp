#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer QLat { float ql[]; };
layout(set = 0, binding = 1) readonly buffer QFull { float qf[]; };
layout(set = 0, binding = 2) readonly buffer KvCache { uint kvc[]; };
layout(set = 0, binding = 3) writeonly buffer Out { float o[]; };
layout(push_constant) uniform PC {
    uint key_dim;
    uint nope;
    uint n_rot;
    uint latent;
    uint pos;
    uint kv_layer_off;
    float kq_scale;
} pc;
shared float smax[256];
shared float ssum[256];
shared float w_shared[4096];
void main() {
    uint h = gl_WorkGroupID.x;
    uint b = gl_WorkGroupID.y;
    uint nh = gl_NumWorkGroups.x;
    uint tid = gl_LocalInvocationID.x;
    uint half_lat = pc.latent >> 1;
    uint half_rot = pc.n_rot >> 1;
    uint half_hd = half_lat + half_rot;
    uint n_t = pc.pos + b + 1u;
    uint ql_base = (b * nh + h) * pc.latent;
    uint qp_base = (b * nh + h) * pc.key_dim + pc.nope;

    float local_max = -1e30;
    for (uint t = tid; t < n_t; t += 256u) {
        uint kb = pc.kv_layer_off + t * half_hd;
        float dot = 0.0;
        for (uint i = 0u; i < half_lat; i++) {
            vec2 kv = unpackHalf2x16(kvc[kb + i]);
            dot += ql[ql_base + 2u * i] * kv.x + ql[ql_base + 2u * i + 1u] * kv.y;
        }
        for (uint i = 0u; i < half_rot; i++) {
            vec2 kv = unpackHalf2x16(kvc[kb + half_lat + i]);
            dot += qf[qp_base + 2u * i] * kv.x + qf[qp_base + 2u * i + 1u] * kv.y;
        }
        float s = dot * pc.kq_scale;
        w_shared[t] = s;
        local_max = max(local_max, s);
    }
    smax[tid] = local_max;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) smax[tid] = max(smax[tid], smax[tid + s]);
        barrier();
    }
    float mx = smax[0];

    float local_sum = 0.0;
    for (uint t = tid; t < n_t; t += 256u) {
        float e = exp(w_shared[t] - mx);
        w_shared[t] = e;
        local_sum += e;
    }
    ssum[tid] = local_sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) ssum[tid] += ssum[tid + s];
        barrier();
    }
    float inv = 1.0 / ssum[0];

    uint out_base = (b * nh + h) * pc.latent;
    for (uint i = tid; i < half_lat; i += 256u) {
        vec2 acc = vec2(0.0);
        for (uint t = 0u; t < n_t; t++) {
            acc += (w_shared[t] * inv) * unpackHalf2x16(kvc[pc.kv_layer_off + t * half_hd + i]);
        }
        o[out_base + 2u * i] = acc.x;
        o[out_base + 2u * i + 1u] = acc.y;
    }
}
